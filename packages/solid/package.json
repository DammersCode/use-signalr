{
  "name": "@dammers/use-signalr-solid",
  "version": "0.4.0",
  "description": "Fully-typed multi-hub SignalR provider + hooks for SolidJS: auto-reconnect, invoke retry, lazy hubs, live status.",
  "author": "Dammers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/use-signalr.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/DammersCode/use-signalr/tree/main/packages/solid#readme",
  "bugs": "https://github.com/DammersCode/use-signalr/issues",
  "keywords": [
    "signalr",
    "typescript",
    "realtime",
    "websocket",
    "solid",
    "solidjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dammers/use-signalr-core": "0.4.0"
  },
  "peerDependencies": {
    "@microsoft/signalr": ">=8",
    "solid-js": ">=1.7"
  },
  "devDependencies": {
    "@microsoft/signalr": ">=8",
    "@solidjs/testing-library": "^0.8.10",
    "solid-js": "^1.9.14",
    "vite-plugin-solid": "^2.11.14"
  }
}
