{
  "name": "@dammers/use-signalr-svelte",
  "version": "1.0.0",
  "description": "Fully-typed multi-hub SignalR provider + stores for Svelte: auto-reconnect, invoke retry, lazy hubs, live status.",
  "author": "Dammers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/use-signalr.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://use-signalr.vercel.app/docs/svelte",
  "bugs": "https://github.com/DammersCode/use-signalr/issues",
  "keywords": [
    "svelte",
    "sveltekit",
    "signalr",
    "stores",
    "typescript",
    "realtime",
    "websocket"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dammers/use-signalr-core": "1.0.0"
  },
  "peerDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "svelte": "^5.15.0"
  },
  "devDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "svelte": "^5.15.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2"
  }
}
