{
  "name": "@dammers/use-signalr-solid",
  "version": "1.0.0",
  "description": "Fully-typed multi-hub SignalR provider + hooks for SolidJS: auto-reconnect, invoke retry, lazy hubs, live status.",
  "author": "Dammers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/use-signalr.git",
    "directory": "packages/solid"
  },
  "homepage": "https://use-signalr.vercel.app/docs/solid",
  "bugs": "https://github.com/DammersCode/use-signalr/issues",
  "keywords": [
    "signalr",
    "typescript",
    "realtime",
    "websocket",
    "solid",
    "solidjs"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dammers/use-signalr-core": "1.0.0"
  },
  "peerDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "solid-js": "^1.7.0"
  },
  "devDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "@solidjs/testing-library": "^0.8.10",
    "solid-js": "^1.7.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
