{
  "name": "@dammers/use-signalr-angular",
  "version": "1.0.0",
  "description": "Fully-typed multi-hub SignalR provider + signals for Angular: auto-reconnect, invoke retry, lazy hubs, live status.",
  "author": "Dammers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/use-signalr.git",
    "directory": "packages/angular"
  },
  "homepage": "https://use-signalr.vercel.app/docs/angular",
  "bugs": "https://github.com/DammersCode/use-signalr/issues",
  "keywords": [
    "angular",
    "signalr",
    "signals",
    "typescript",
    "realtime",
    "websocket"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rxjs-interop": {
      "types": "./dist/rxjs-interop.d.ts",
      "import": "./dist/rxjs-interop.js",
      "default": "./dist/rxjs-interop.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dammers/use-signalr-core": "1.0.0"
  },
  "peerDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "rxjs": "^7.6.0"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/compiler": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "rxjs": "^7.6.0",
    "zone.js": "~0.15.0"
  }
}
