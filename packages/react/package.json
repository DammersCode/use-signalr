{
  "name": "@dammers/use-signalr-react",
  "version": "0.5.0",
  "description": "Fully-typed multi-hub SignalR provider + hooks for React: auto-reconnect, invoke retry, lazy hubs, live status.",
  "author": "Dammers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/use-signalr.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/DammersCode/use-signalr/tree/main/packages/react#readme",
  "bugs": "https://github.com/DammersCode/use-signalr/issues",
  "keywords": [
    "signalr",
    "typescript",
    "realtime",
    "websocket",
    "react",
    "hooks"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dammers/use-signalr-core": "0.5.0"
  },
  "peerDependencies": {
    "@microsoft/signalr": ">=8",
    "react": ">=19"
  },
  "devDependencies": {
    "@microsoft/signalr": ">=8",
    "@testing-library/react": "^16.1.0",
    "@types/react": ">=19",
    "react": ">=19",
    "react-dom": ">=19"
  }
}
