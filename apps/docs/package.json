{
  "name": "@dammers/use-signalr-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/gen-content.mjs",
    "dev": "node scripts/gen-content.mjs --watch",
    "build": "node scripts/gen-content.mjs --strict && fumadocs-mdx && next build",
    "start": "next start",
    "snippets": "node scripts/check-snippets.mjs",
    "typecheck": "node scripts/gen-content.mjs --strict && fumadocs-mdx && next typegen && tsc --noEmit && node scripts/check-snippets.mjs"
  },
  "dependencies": {
    "@dammers/use-signalr-core": "1.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "fumadocs-core": "^16.15.17",
    "fumadocs-mdx": "^15.4.5",
    "fumadocs-typescript": "^5.4.1",
    "fumadocs-ui": "^16.15.17",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@microsoft/signalr-protocol-msgpack": "^10.0.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
