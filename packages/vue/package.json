{
  "name": "@dammers/use-signalr-vue",
  "version": "0.4.0",
  "description": "Fully-typed multi-hub SignalR plugin + composables for Vue.",
  "author": "Dammers",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/DammersCode/use-signalr.git", "directory": "packages/vue" },
