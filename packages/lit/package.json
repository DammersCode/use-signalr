{
  "name": "@dammers/use-signalr-lit",
  "version": "1.0.0",
  "description": "Fully-typed SignalR Reactive Controllers for Lit.",
  "author": "Dammers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/use-signalr.git",
    "directory": "packages/lit"
  },
  "homepage": "https://use-signalr.vercel.app/docs/lit",
  "bugs": {
    "url": "https://github.com/DammersCode/use-signalr/issues"
  },
  "keywords": [
    "signalr",
    "typescript",
    "lit",
    "web-components"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dammers/use-signalr-core": "1.0.0"
  },
  "peerDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "lit": "^3.0.0"
  }
}
